# Generate X values

x <- seq(20, 80, by = 1)


# Density values

y <- dnorm(x, mean = 50, sd = 10)


# Give the chart file a name.

png(file = "dnorm.png")



# Plot

plot(x, y,
     
     type = "p",
     
     pch = 19,
     
     col = "blue",
     
     main="Normal Density (dnorm)",
     
     xlab = "Marks",
     
     ylab = "Density")


# Regression line

model <- lm(y ~ x)

abline(model, col = "red", lwd = 2)


# Model summary

summary(model)

dev.off()

#pnorm
  
x <- seq(20,80,1)


y <- pnorm(x, mean=50, sd=10)

png(file='pnorm.png')

plot(x,y,
     
     pch=19,
     
     col="blue",
     
     main="Cumulative Probability (pnorm)",
     
     xlab="Marks",
     
     ylab="Probability")


model <- lm(y~x)

abline(model,col="red",lwd=2)


summary(model)

dev.off()

#Qnorm:
  
p <- seq(0.01,0.99,0.05)


x <- qnorm(p, mean=50, sd=10)

png(file='qnorm.png')

plot(p,x,
     
     pch=19,
     
     col="blue",
     
     main="Quantile Function (qnorm)",
     
     xlab="Probability",
     
     ylab="Marks")


model <- lm(x~p)

abline(model,col="red",lwd=2)


summary(model)

dev.off()

